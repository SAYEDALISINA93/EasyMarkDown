{
  "manifest_version": 3,
  "name": "EasyMarkDown",
  "version": "1.0.0",
  "description": "Render Markdown files beautifully in your browser. Intercepts .md URLs and provides a drag-and-drop viewer.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "EasyMarkDown",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["file://*/*"],
      "js": ["lib/marked.min.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["viewer.html", "styles/viewer.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["file://*/*"]
}
