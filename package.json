{
  "name": "easymarkdown",
  "version": "1.0.0",
  "description": "Browser extension to render Markdown files",
  "scripts": {
    "dev": "npm run build:content && vite build --watch",
    "build": "vite build && vite build --config vite.content.config.ts",
    "build:content": "vite build --config vite.content.config.ts",
    "build:firefox": "cp public/manifest.json public/manifest.chrome.json && cp public/manifest.firefox.json public/manifest.json && npm run build; mv public/manifest.chrome.json public/manifest.json",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SAYEDALISINA93/EasyMarkDown.git"
  },
  "keywords": [],
  "author": "Alisina",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SAYEDALISINA93/EasyMarkDown/issues"
  },
  "homepage": "https://github.com/SAYEDALISINA93/EasyMarkDown#readme",
  "devDependencies": {
    "@types/marked": "^5.0.2",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "marked": "^18.0.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
